# Copy to .env in the repository root. Leave model credentials blank to use Pi config.
# Process environment overrides .env; .env and .pi/ are ignored by Git.
CAMPUS_AGENT_BASE_URL=
CAMPUS_AGENT_API_KEY=
CAMPUS_AGENT_MODEL=deepseek-v4.1-flash-1017
CAMPUS_AGENT_API=openai-completions
# Optional per-process proxy; leave blank for inherited HTTP(S)_PROXY/direct access.
CAMPUS_AGENT_PROXY_URL=
# Optional Pi config directory, relative to the repository root.
# PI_CODING_AGENT_DIR=.pi/agent
# Optional explicit directory containing @earendil-works/pi-coding-agent.
# CAMPUS_PI_SDK_ROOT=/path/to/node_modules
# Main site used by the worker (loopback only).
CAMPUS_AGENT_PRODUCT_ORIGIN=http://127.0.0.1:3000
# Optional persistent locations. Web and Studio must use matching database/media paths.
# DATABASE_URL=file:/absolute/path/pulse.db
# CAMPUS_DATA_DIR=/absolute/path/data
# CAMPUS_MEDIA_DIR=/absolute/path/data/media
