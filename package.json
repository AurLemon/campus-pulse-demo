{
	"name": "campus-pulse",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.5.1",
	"engines": {
		"node": "^24.15.0"
	},
	"scripts": {
		"dev": "pnpm dev:web",
		"build": "pnpm build:web && pnpm build:studio",
		"preview": "nuxt preview apps/web",
		"postinstall": "prisma generate && nuxt prepare apps/web && nuxt prepare apps/studio",
		"lint": "eslint apps/web/app apps/web/server apps/studio/app apps/studio/server packages tools scripts modules types",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "nuxt typecheck apps/web && nuxt typecheck apps/studio && tsc -p scripts/tsconfig.json",
		"agent:probe": "node tools/agents/probe.ts",
		"agent:run": "node tools/agents/run.ts",
		"db:generate": "prisma generate",
		"data:small": "node tools/content/generate.ts --small",
		"data:validate": "node tools/content/cli.ts validate",
		"data:import": "node tools/content/cli.ts import",
		"data:reset": "node tools/content/cli.ts reset",
		"data:generate": "node tools/content/generate.ts",
		"dev:web": "nuxt dev apps/web --host 127.0.0.1",
		"dev:studio": "nuxt dev apps/studio --host 127.0.0.1 --port 3001",
		"build:web": "nuxt build apps/web",
		"build:studio": "nuxt build apps/studio",
		"db:push": "node scripts/database.ts db push",
		"data:refresh": "node tools/content/refresh-community.ts",
		"data:seed": "node tools/content/seed.ts",
		"data:assets": "node tools/content/fetch-assets.ts",
		"data:pack": "node tools/content/bundle-cli.ts pack",
		"data:unpack": "node tools/content/bundle-cli.ts unpack",
		"admin": "node tools/content/admin.ts",
		"data:assets:pack": "node tools/content/bundle-cli.ts pack --assets",
		"data:assets:unpack": "node tools/content/bundle-cli.ts unpack --assets",
		"data:snapshots:pack": "node tools/content/bundle-cli.ts pack --snapshots",
		"data:snapshots:unpack": "node tools/content/bundle-cli.ts unpack --snapshots"
	},
	"dependencies": {
		"@campus/contracts": "workspace:*",
		"@campus/domain": "workspace:*",
		"@campus/recommendation": "workspace:*",
		"@nuxt/ui": "4.12.0",
		"@nuxtjs/i18n": "10.6.0",
		"@prisma/adapter-better-sqlite3": "7.10.1",
		"@prisma/client": "7.10.1",
		"better-sqlite3": "12.11.1",
		"dayjs": "1.11.23",
		"h3": "1.15.11",
		"nuxt": "4.6.4",
		"sharp": "0.35.5",
		"tailwindcss": "4.3.4",
		"tdesign-icons-vue-next": "0.4.12",
		"tdesign-vue-next": "1.20.10",
		"vue": "3.5.44"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.150",
		"@nuxt/eslint": "1.17.0",
		"@tailwindcss/vite": "4.3.4",
		"@tdesign-vue-next/nuxt": "0.2.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "24.19.2",
		"@types/proper-lockfile": "4.1.4",
		"eslint": "10.14.0",
		"prettier": "3.9.10",
		"prisma": "7.10.1",
		"proper-lockfile": "4.1.2",
		"tar": "7.5.22",
		"typescript": "5.9.3",
		"vue-tsc": "3.3.14"
	}
}
