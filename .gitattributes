* text=auto
*.md text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf

# Exclude offline tools from GitHub language statistics.
/tools/** -linguist-detectable
/tools/content/generated-content.tar.gz binary linguist-generated=true
/apps/studio/server/assets/*.json linguist-generated=true
/tools/content/assets.tar.gz binary linguist-generated=true
/tools/content/snapshots.tar.gz binary linguist-generated=true
